{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zyrax",
  "version": "0.1.0",
  "identifier": "com.zyrax.app",
  "build": {
    "beforeDevCommand": "bun run layer:build && bun run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run layer:build && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Zyrax",
        "width": 1000,
        "height": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": {
        "default-src": ["'self'"],
        "script-src": ["'self'"],
        "style-src": ["'self'", "'unsafe-inline'", "https://fonts.googleapis.com"],
        "img-src": ["'self'", "data:"],
        "font-src": ["'self'", "https://fonts.gstatic.com"],
        "connect-src": ["'self'", "ipc:", "http://ipc.localhost"],
        "object-src": ["'none'"],
        "base-uri": ["'self'"],
        "form-action": ["'self'"],
        "frame-ancestors": ["'none'"]
      },
      "devCsp": {
        "default-src": ["'self'", "http://localhost:5173"],
        "script-src": ["'self'", "http://localhost:5173"],
        "style-src": ["'self'", "'unsafe-inline'", "http://localhost:5173", "https://fonts.googleapis.com"],
        "img-src": ["'self'", "data:", "http://localhost:5173"],
        "font-src": ["'self'", "https://fonts.gstatic.com", "http://localhost:5173"],
        "connect-src": [
          "'self'",
          "ipc:",
          "http://ipc.localhost",
          "http://localhost:5173",
          "ws://localhost:5173"
        ],
        "object-src": ["'none'"],
        "base-uri": ["'self'"],
        "form-action": ["'self'"],
        "frame-ancestors": ["'none'"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
